{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Library App (Launch Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "vite:///*": "${webRoot}/*",
        "/@fs/*": "/*",
        "/*": "${webRoot}/*"
      }
    },
    {
      "name": "Attach to Chrome (Port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
